{% extends 'base.html.twig' %}

{% block title %}Sign Up{% endblock %}

{% block body_class %}bg-gradient-to-br from-green-50 to-emerald-100 min-h-screen{% endblock %}

{% block body %}
<div class="min-h-screen flex items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-md w-full space-y-8">
        <div>
            <!-- Logo/Icon -->
            <div class="mx-auto h-16 w-16 flex items-center justify-center bg-emerald-600 rounded-full shadow-lg">
                <svg class="h-8 w-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                </svg>
            </div>
            <h2 class="mt-6 text-center text-3xl font-extrabold text-gray-900">
                Create your account
            </h2>
            <p class="mt-2 text-center text-sm text-gray-600">
                Join us today! Please fill out the form below.
            </p>
        </div>
        
        <div class="bg-white py-8 px-4 shadow-xl rounded-lg sm:px-10">
            <!-- Flash Messages -->
            {% for flash_error in app.flashes('verify_email_error') %}
                <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md" role="alert">
                    <div class="flex">
                        <div class="flex-shrink-0">
                            <svg class="h-5 w-5 text-red-400" viewBox="0 0 20 20" fill="currentColor">
                                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd"></path>
                            </svg>
                        </div>
                        <div class="ml-3">
                            <p class="text-sm font-medium">{{ flash_error }}</p>
                        </div>
                    </div>
                </div>
            {% endfor %}

            <!-- Form Errors -->
            {% if form_errors(registrationForm) %}
                <div class="mb-4 bg-red-50 border border-red-200 text-red-700 px-4 py-3 rounded-md" role="alert">
                    {{ form_errors(registrationForm) }}
                </div>
            {% endif %}
            
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-6'}}) }}
                <div>
                    {{ form_label(registrationForm.email, 'Email address', {'attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    <div class="mt-1 relative">
                        {{ form_widget(registrationForm.email, {
                            'attr': {
                                'class': 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:ring-emerald-500 focus:border-emerald-500 transition duration-150 ease-in-out sm:text-sm',
                                'placeholder': 'Enter your email address'
                            }
                        }) }}
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 12a4 4 0 10-8 0 4 4 0 008 0zm0 0v1.5a2.5 2.5 0 005 0V12a9 9 0 10-9 9m4.5-1.206a8.959 8.959 0 01-4.5 1.207"></path>
                            </svg>
                        </div>
                    </div>
                    {% if form_errors(registrationForm.email) %}
                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(registrationForm.email) }}
                        </div>
                    {% endif %}
                </div>

                <div>
                    {{ form_label(registrationForm.plainPassword, 'Password', {'attr': {'class': 'block text-sm font-medium text-gray-700'}}) }}
                    <div class="mt-1 relative">
                        {{ form_widget(registrationForm.plainPassword, {
                            'attr': {
                                'class': 'appearance-none block w-full px-3 py-2 border border-gray-300 rounded-md placeholder-gray-400 focus:outline-none focus:ring-emerald-500 focus:border-emerald-500 transition duration-150 ease-in-out sm:text-sm',
                                'placeholder': 'Create a secure password'
                            }
                        }) }}
                        <div class="absolute inset-y-0 right-0 pr-3 flex items-center pointer-events-none">
                            <svg class="h-5 w-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
                            </svg>
                        </div>
                    </div>
                    {% if form_errors(registrationForm.plainPassword) %}
                        <div class="mt-1 text-sm text-red-600">
                            {{ form_errors(registrationForm.plainPassword) }}
                        </div>
                    {% endif %}
                    <div class="mt-1 text-xs text-gray-500">
                        Password must be at least 6 characters long.
                    </div>
                </div>

                <div class="flex items-start">
                    <div class="flex items-center h-5">
                        {{ form_widget(registrationForm.agreeTerms, {
                            'attr': {
                                'class': 'h-4 w-4 text-emerald-600 focus:ring-emerald-500 border-gray-300 rounded'
                            }
                        }) }}
                    </div>
                    <div class="ml-3 text-sm">
                        {{ form_label(registrationForm.agreeTerms, null, {
                            'label_attr': {'class': 'text-gray-600'}
                        }) }}
                        I agree to the 
                        <a href="#" class="text-emerald-600 hover:text-emerald-500 font-medium">Terms of Service</a> 
                        and 
                        <a href="#" class="text-emerald-600 hover:text-emerald-500 font-medium">Privacy Policy</a>
                    </div>
                </div>
                {% if form_errors(registrationForm.agreeTerms) %}
                    <div class="text-sm text-red-600">
                        {{ form_errors(registrationForm.agreeTerms) }}
                    </div>
                {% endif %}

                <div>
                    <button type="submit" class="group relative w-full flex justify-center py-2 px-4 border border-transparent text-sm font-medium rounded-md text-white bg-emerald-600 hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition duration-150 ease-in-out">
                        <span class="absolute left-0 inset-y-0 flex items-center pl-3">
                            <svg class="h-5 w-5 text-emerald-500 group-hover:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z"></path>
                            </svg>
                        </span>
                        Create Account
                    </button>
                </div>

                <div class="text-center">
                    <p class="text-sm text-gray-600">
                        Already have an account?
                        <a href="{{ path('app_login') }}" class="font-medium text-emerald-600 hover:text-emerald-500 transition duration-150 ease-in-out">
                            Sign in
                        </a>
                    </p>
                </div>
            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}
