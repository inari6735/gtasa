{% extends 'base.html.twig' %}

{% block title %}Media{% endblock %}

{% block body %}
    <div data-controller="upload">
        <form data-action="submit->upload#submit">
            <label for="file">Select a file to upload</label>
            <input type="file" id="file" name="file" data-action="change->upload#resetProgress">

            <label for="isPublic">Select a file to upload</label>
            <input type="checkbox" id="isPublic" name="isPublic">

            <input type="submit" value="Submit">
        </form>

        <div class="progress-bar">
            <progress value="0" max="100" data-upload-target="bar" style="width: 320px;"></progress>
            <span data-upload-target="label">0%</span>
        </div>
    </div>
{% endblock %}
