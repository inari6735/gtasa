{% extends 'base.html.twig' %}

{% block title %}Media{% endblock %}

{% block stylesheets %}
    <link rel="stylesheet" href="{{ asset('styles/media/upload.css') }}">
{% endblock %}

{% block body %}
    <div class="uploader" data-controller="upload">
        <form data-action="submit->upload#submit">
            <div class="input-wrapper">
                <input class="form-input form-file" type="file" id="file" name="file" data-action="change->upload#onFilesSelected" multiple>
            </div>
            <div class="input-wrapper">
                <label class="form-label" for="isPublic">Publiczny</label>
                <input class="form-input" type="checkbox" id="isPublic" name="isPublic">
            </div>
            <div class="input-wrapper">
                <input class="form-submit" type="submit" value="Submit">
            </div>
        </form>

        <div class="uploads" data-upload-target="list" aria-live="polite"></div>
    </div>
{% endblock %}
